# weft tunnel egress (server). Rendered by main.tf into cloud-init as /etc/weft/egress.nft.
table inet weft_egress
delete table inet weft_egress
table inet weft_egress {
  set not_public4 {
    type ipv4_addr
    flags interval
    elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12,
                 192.0.0.0/24, 192.0.2.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24,
                 203.0.113.0/24, 224.0.0.0/3 }
  }
  chain forward {
    type filter hook forward priority filter - 10; policy accept;
    iifname "wg0" oifname "wg0" counter drop
    iifname "wg0" meta nfproto ipv6 counter drop
    iifname "wg0" ip daddr @not_public4 counter drop
    oifname "wg0" ip saddr @not_public4 counter drop
    tcp flags syn tcp option maxseg size set rt mtu
  }
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    ip saddr ${tunnel_cidr} oifname != "wg0" masquerade
  }
}
